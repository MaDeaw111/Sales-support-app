{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wcat-sales-support",
  "main": "./src/index.js",
  "compatibility_date": "2026-08-23",
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wcat-sales-db",
      "database_id": "f1618ec6-84b5-46bb-a2ad-b0317e561d65",
      "migrations_dir": "migrations"
    }
  ]
}
